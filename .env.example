# --- CONFIGURAÇÕES DE IA (OPENAI) ---
# Necessário para o nó "Transcrever Áudio" e "AI Agent"
OPENAI_API_KEY=sua_chave_sk_aqui

# --- BACKEND & DATABASE (SUPABASE) ---
# URL base do seu projeto Supabase (ex: https://xyz.supabase.co)
SUPABASE_URL=https://sua-url.supabase.co
# Chave x-api-key usada nas Edge Functions (n8n-bot-control, etc)
SUPABASE_API_KEY=sua_chave_supabase_aqui

# --- MENSAGERIA (EVOLUTION API) ---
# URL da sua instância Evolution (ex: https://evo.dominio.com)
EVOLUTION_API_URL=https://sua-instancia-evo.com
# API Key da Evolution usada nos nós "Enviar WhatsApp1" e "Baixar Áudio"
EVOLUTION_API_KEY=seu_token_da_api_aqui

# --- MEMÓRIA DE CHAT (POSTGRES) ---
# Credenciais para o nó "Postgres Chat Memory"
POSTGRES_HOST=seu_host_aqui
POSTGRES_PORT=5432
POSTGRES_DATABASE=seu_banco_de_dados
POSTGRES_USER=seu_usuario
POSTGRES_PASSWORD=sua_senha_segura
